# ---------------------------------------------------------------------------
# Copy this file to .env and fill in what you have. Anything left blank makes
# the app fall back to a mode that still runs, just with fewer smarts.
# ---------------------------------------------------------------------------

# Notes and Q&A. Set either one; if both are present Claude is used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Speech to text. Uses OPENAI_API_KEY unless you set a key here.
# Point the base URL at a local whisper.cpp / faster-whisper server to run
# transcription offline and for free:
#   LECTUREFLOW_TRANSCRIBE_BASE_URL=http://127.0.0.1:8080/v1
LECTUREFLOW_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
LECTUREFLOW_TRANSCRIBE_BASE_URL=https://api.openai.com/v1
LECTUREFLOW_TRANSCRIBE_API_KEY=

# Spoken language hint (ISO-639-1). Leave blank to let the model auto-detect.
LECTUREFLOW_LANGUAGE=zh

# Text model overrides.
LECTUREFLOW_TEXT_PROVIDER=auto
LECTUREFLOW_ANTHROPIC_MODEL=claude-opus-5
LECTUREFLOW_ANTHROPIC_EFFORT=low
LECTUREFLOW_OPENAI_TEXT_MODEL=gpt-4o-mini
LECTUREFLOW_OPENAI_BASE_URL=https://api.openai.com/v1

# Server.
LECTUREFLOW_HOST=127.0.0.1
LECTUREFLOW_PORT=8000
